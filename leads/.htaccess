# Block all direct access to the leads backup log.
# Only submit-contact.php (running as the web user) can write to it;
# nothing in this directory should ever be served over HTTP.

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 (Hostinger sometimes still uses this)
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# Belt-and-braces: deny by file pattern too
<FilesMatch "\.(jsonl|log|txt|json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
