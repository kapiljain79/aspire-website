# =============================================================
# 301 redirect: aspireitconsult.com (and www) -> aspireitsystems.io
# Preserves the request path so /contact -> /contact, /services -> /services, etc.
# Comment out the RewriteRule block if you stop owning aspireitconsult.com.
# =============================================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_HOST} ^(www\.)?aspireitconsult\.com$ [NC]
    RewriteRule ^(.*)$ https://www.aspireitsystems.io/$1 [R=301,L]
</IfModule>

# Protect server-side config and library files from direct HTTP access.

<FilesMatch "^(mail-config\.php|mail-config\.example\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
